# ===============================================================================
# KITAAB BANK - PRODUCTION ENVIRONMENT CONFIGURATION
# ===============================================================================
# Copy this file to '.env' on the host computer and customize the values below.
# Never commit the actual '.env' file containing real secrets to version control.
# ===============================================================================

# -------------------------------------------------------------------------------
# 1. SECURITY & AUTHENTICATION SECRETS (MANDATORY FOR PRODUCTION)
# -------------------------------------------------------------------------------
# Stable Secret Key for signing session cookies and CSRF tokens.
# Generate a cryptographically secure 64-character hex key using:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_a_secure_random_64_character_hex_token

# Initial Administrator Password used when creating the first 'teacher' account.
# Must be at least 8 characters with uppercase, lowercase, number, and special character.
# Note: The system will force a password change upon first login.
INITIAL_TEACHER_PASSWORD=Teacher@Secure2026!

# -------------------------------------------------------------------------------
# 2. SCHOOL IDENTITY & DISPLAY SETTINGS
# -------------------------------------------------------------------------------
# Official name of the school displayed on portal headers, receipts, and book labels.
SCHOOL_NAME=Government High School No. 1

# -------------------------------------------------------------------------------
# 3. RATE LIMITING & ABUSE PREVENTION
# -------------------------------------------------------------------------------
# Configured for shared school Wi-Fi and NAT gateways to allow batch classroom usage.
# Number of donation submissions allowed per IP per hour:
RATE_LIMIT_DONATE_PER_HOUR=120

# Number of book requests allowed per IP per hour:
RATE_LIMIT_REQUEST_PER_HOUR=120

# Number of search and inventory tracking queries allowed per IP per minute:
RATE_LIMIT_TRACK_PER_MINUTE=30

# Maximum consecutive failed login attempts before locking out the client IP:
RATE_LIMIT_LOGIN_FAILURES=5

# Duration of the login lockout window in seconds (default: 900 seconds / 15 minutes):
RATE_LIMIT_LOGIN_WINDOW_SECONDS=900

# Comma-separated list of trusted upstream reverse proxy IPs (if behind Nginx/Caddy).
# Leave blank when clients connect directly to Waitress on local Wi-Fi:
TRUSTED_PROXY_IPS=

# -------------------------------------------------------------------------------
# 4. STORAGE PATH OVERRIDES (OPTIONAL - DEFAULTS TO PROJECT DIRECTORY)
# -------------------------------------------------------------------------------
# Uncomment and set absolute paths if storing data on a separate high-speed drive:
# DATABASE_PATH=D:\KitaabBankData\kitaab_bank.db
# BACKUP_FOLDER=D:\KitaabBankData\backups
# UPLOAD_FOLDER=D:\KitaabBankData\uploads\books
# QR_FOLDER=D:\KitaabBankData\uploads\qr
